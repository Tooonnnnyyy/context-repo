{
  "name": "context-repo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4190 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4190 --strictPort",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check": "npm run check:privacy && npm test && npm run build",
    "dev:full": "npm run build && wrangler dev --port 8795",
    "deploy": "npm run check && wrangler deploy",
    "db:local": "wrangler d1 migrations apply context-repo --local",
    "db:remote": "wrangler d1 migrations apply context-repo --remote"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.0",
    "better-auth": "^1.4.0",
    "drizzle-orm": "^0.44.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20261111.0",
    "@playwright/test": "^1.56.0",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.0",
    "wrangler": "^4.161.0"
  }
}
